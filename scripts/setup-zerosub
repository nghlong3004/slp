#!/usr/bin/env python3
"""Prepare SLP locally, then install the requested ZeroSub version on the host."""
import argparse
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
from slp_core.common import Installation, SlpError, atomic_write, read_toml, state_home
from slp_core import paseo


def run(command, timeout=30, capture=False):
    result = subprocess.run(command, text=True, capture_output=capture, timeout=timeout)
    if result.returncode:
        detail = (result.stderr or result.stdout or "").strip() if capture else "See command output above."
        raise SlpError(f"Command failed ({result.returncode}): {command[0]} {command[1] if len(command) > 1 else ''}. {detail[:800]}")
    return result.stdout.strip() if capture else ""


def prepare(installation):
    provider = installation.provider("codex")
    if provider.get("account_routing") != "zerosub":
        raise SlpError('Set providers/codex.toml account_routing="zerosub" first')
    config = read_toml(installation.config / "zerosub.toml")
    if not config.get("version"):
        raise SlpError("ZeroSub version must be pinned")
    if config["preferences"].get("forkOtherProvider") or config["preferences"].get("autoRedeem"):
        raise SlpError("This Codex-only setup requires cross-provider fork and automatic reset spending off")
    paseo.sync(installation)
    target = paseo.home() / "config.json"
    persisted = json.loads(target.read_text())
    if persisted.get("pluginsEnabled") is not True:
        persisted["pluginsEnabled"] = True
        paseo.validate(persisted)
        stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
        atomic_write(state_home() / "backups" / f"before-zerosub-{stamp}.json", target.read_text())
        atomic_write(target, json.dumps(persisted, indent=2, ensure_ascii=False) + "\n")
    preferences = installation.runtime / "zerosub-preferences.json"
    atomic_write(preferences, json.dumps(config["preferences"], indent=2) + "\n")
    return config, preferences


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--prepare", action="store_true", help="Prepare local config only; do not claim the plugin is installed")
    options = parser.parse_args()
    installation = Installation.load()
    config, preferences = prepare(installation)
    if options.prepare:
        print(f"Prepared for ZeroSub {config['version']}; plugin download and daemon activation are still required.")
        return
    binary = shutil.which("paseo")
    npm = shutil.which("npm")
    node = shutil.which("node")
    if not all((binary, npm, node)):
        raise SlpError("paseo, npm, and node must be on the host PATH")
    version = config["version"]
    available = json.loads(run([npm, "--fetch-timeout=15000", "--fetch-retries=0", "view",
                               f"@kapybara/zerosub@{version}", "version", "--json"], capture=True))
    if available != version:
        raise SlpError(f"npm did not confirm exactly the requested ZeroSub {version}")
    # The host CLI resolves its own daemon and credentials; never start a
    # competing daemon or infer that an invisible host process is stopped.
    run([binary, "daemon", "reload", "--home", str(paseo.home()), "--json"])
    run([binary, "plugin", "install", f"npm:@kapybara/zerosub@{version}",
         "--home", str(paseo.home()), "--json"], timeout=180)
    installed = json.loads((paseo.home() / "config.json").read_text()).get("plugins", {}).get("zerosub")
    if not installed or installed.get("enabled") is False:
        raise SlpError("ZeroSub was not enabled in the daemon configuration")
    package = Path(installed["path"]).expanduser() / "package.json"
    actual_version = json.loads(package.read_text()).get("version")
    if actual_version != version:
        raise SlpError(f"Installed ZeroSub version mismatch: expected {version}, got {actual_version}")
    cli_root = Path(binary).resolve().parent.parent
    run([node, str(installation.root / "scripts/lib/zerosub-settings.mjs"),
         str(cli_root), str(paseo.home()), str(preferences)])
    run([binary, "plugin", "ls", "zerosub", "--home", str(paseo.home()), "--json"])
    atomic_write(installation.runtime / "zerosub-installation.json", json.dumps({
        "version": actual_version, "installed_path": str(package.parent),
        "preferences_applied": True, "checked_at": datetime.now(timezone.utc).isoformat(),
    }, indent=2) + "\n")
    print(f"ZeroSub {actual_version} installed and configured for Codex. Open Accounts (ZeroSub) in Paseo to add your accounts.")


if __name__ == "__main__":
    try:
        main()
    except (SlpError, OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"setup-zerosub: {error}", file=sys.stderr)
        raise SystemExit(1) from None
